# Production values; keep real secrets in hosting environment settings.
OCTANE_ENV=production
OCTANE_DEMO=0
# Dedicated non-superuser LOGIN granted sentinel_app; never use postgres or a Supabase service-role key.
DATABASE_URL=postgresql://sentinel_login:REPLACE_ME@YOUR_DATABASE:5432/postgres?sslmode=require
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=REPLACE_WITH_PUBLIC_PUBLISHABLE_OR_ANON_KEY
OCTANE_AI_PROVIDER=none
OPENROUTER_API_KEY=
# Choose an actual OpenRouter model supporting json_schema. There is intentionally no invented default.
OCTANE_AI_MODEL=
PORT=8000
# Set only in a separate explicit migration session; do not configure in normal app runtime.
# MIGRATION_DATABASE_URL=postgresql://MIGRATION_OWNER:SECRET@YOUR_DATABASE:5432/postgres?sslmode=require
